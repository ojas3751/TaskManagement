{
  "permissions": {
    "allow": [
      "PowerShell(\\(Invoke-WebRequest -Uri \"http://127.0.0.1:5173/\" -UseBasicParsing\\).StatusCode)",
      "PowerShell(\\(Invoke-WebRequest -Uri \"http://127.0.0.1:5173/app.js\" -UseBasicParsing\\).StatusCode)",
      "PowerShell(git add -A)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git checkout:*)",
      "PowerShell(git switch:*)",
      "PowerShell(git pull:*)",
      "PowerShell(git push:*)",
      "PowerShell(git fetch:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git remote:*)",
      "PowerShell(git stash:*)",
      "PowerShell(gh issue:*)",
      "PowerShell(gh pr view:*)",
      "PowerShell(gh pr create:*)",
      "PowerShell(gh pr list:*)",
      "PowerShell(gh pr diff:*)",
      "PowerShell(gh repo view:*)",
      "PowerShell(npm:*)",
      "PowerShell(npx:*)",
      "PowerShell(node:*)",
      "PowerShell(curl.exe:*)",
      "PowerShell(docker compose up:*)",
      "PowerShell(docker compose stop:*)",
      "PowerShell(docker compose start:*)",
      "PowerShell(docker compose ps:*)",
      "PowerShell(docker compose logs:*)",
      "PowerShell(.\\gradlew.bat:*)",
      "PowerShell(pwsh -File scripts/free-port.ps1:*)"
    ],
    "deny": [
      "PowerShell(Remove-Item:*)",
      "PowerShell(rm:*)",
      "PowerShell(rd:*)",
      "PowerShell(rmdir:*)",
      "PowerShell(del:*)",
      "PowerShell(Move-Item:*)",
      "PowerShell(mv:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git clean:*)",
      "PowerShell(git branch -D:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git push --force-with-lease:*)",
      "PowerShell(gh repo delete:*)",
      "PowerShell(docker compose down -v:*)",
      "PowerShell(docker compose down --volumes:*)",
      "PowerShell(gh pr merge:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git.ps1"]
          },
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-ports.ps1"]
          }
        ]
      }
    ]
  }
}
