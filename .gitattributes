# Git フックは Git に同梱の sh で動くため、改行を LF に固定する（CRLF だと実行できない）
.githooks/* text eol=lf

# Terraform のファイルも LF に固定する。ec2.tf のユーザーデータは Linux のサーバーで
# シェルスクリプトとして実行されるため、CRLF が混ざると正しく動かないおそれがある
*.tf text eol=lf
# EC2 の中で bash として実行する手順（scripts/aws/remote）も同じ理由で LF に固定する
*.sh text eol=lf
# EC2 に置く設定ファイル（nginx・systemd）とユーザーデータのテンプレートも、Linux で読むので LF に固定する
infra/ec2-setup/** text eol=lf
*.tfvars.example text eol=lf
.terraform.lock.hcl text eol=lf
