# =============================================================================
# Terraform 本体と、AWS を操作する部品（プロバイダ）の設定
# =============================================================================
#
# Terraform は、このフォルダの中の .tf ファイルを「全部まとめて1つ」として読む。
# ファイルの分け方は人が読みやすくするためのもので、どのファイルに何を書いても動きは同じ。

terraform {
  # Terraform 本体の版。1.16 系なら動く。
  required_version = "~> 1.16"

  required_providers {
    # AWS を操作するための部品。HashiCorp 社が公開しているものを使う。
    # "~> 6.68" は「6.68 以上、7.0 未満」という意味。
    # 実際に使った版は .terraform.lock.hcl に記録され、そのファイルはコミットする。
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.68"
    }
  }
}

provider "aws" {
  region = var.region

  # どの AWS の鍵（プロファイル）を使うかは、ここには書かない。
  # 書くとその鍵で動くことが決まってしまい、AI が読み取り専用で plan を実行できなくなる。
  # 実行するときに、環境変数 AWS_PROFILE で指定する（README）。

  # ここで作るすべてのものに、自動で付ける名札（タグ）。
  # コンソールで「このプロジェクトが Terraform で作ったもの」と見分けるため。
  default_tags {
    tags = {
      Project   = "taskmgmt"
      ManagedBy = "terraform"
    }
  }
}
